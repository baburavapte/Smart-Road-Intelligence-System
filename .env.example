# RoadSense AI — Root Environment Variables Template
# Copy this file to server/.env or supply these environment variables to Docker/hosting provider

JWT_SECRET=your-32-character-random-secret-key-here
MONGO_URI=mongodb://localhost:27017/pothole-detection
PORT=3000
NODE_ENV=development
FLASK_URL=http://localhost:5001
FRONTEND_URL=http://localhost:4200
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
ADMIN_EMAIL=admin@smartcity.gov.in
ROADSENSE_API_KEY=your-mcp-server-api-key
